# ─────────────────────────────────────────────────────────────────────────────
# RetailOS — Environment Variables
# Copy this file to .env and fill in the values before running the stack.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Async URL used by SQLAlchemy / FastAPI at runtime
DATABASE_URL=postgresql+asyncpg://retailos:retailos_password@postgres:5432/retailos
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql://retailos:retailos_password@postgres:5432/retailos

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── AWS (S3 file storage + Textract OCR) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=retailos-files

# ── OCR Provider ──────────────────────────────────────────────────────────────
# Options: textract | google_vision | local
OCR_PROVIDER=local

# ── Application ───────────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development
DEBUG=true
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public API base URL (visible in the browser)
NEXT_PUBLIC_API_URL=http://localhost/api
